generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  plan      String   @default("free")
  features  Json     @default("{}")
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  
  users    User[]
  projects Project[]
  
  @@map("tenants")
}

model User {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  role         String   @default("user")
  permissions  Json     @default("[]")
  mfaEnabled   Boolean  @default(false) @map("mfa_enabled")
  mfaSecret    String?  @map("mfa_secret")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  
  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  projects Project[]
  apiKeys  ApiKey[]
  
  @@map("users")
}

model ApiKey {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  name        String
  keyHash     String   @map("key_hash")
  permissions Json     @default("[]")
  lastUsedAt  DateTime? @map("last_used_at")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  revokedAt   DateTime? @map("revoked_at")
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("api_keys")
}

model Project {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  vehicleInfo Json     @default("{}") @map("vehicle_info")
  ecuType     String?  @map("ecu_type")
  status      String   @default("draft")
  settings    Json     @default("{}")
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  
  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  creator      User         @relation(fields: [createdBy], references: [id])
  ecuFiles     EcuFile[]
  simulations  Simulation[]
  aiAnalyses   AiAnalysis[]
  
  @@map("projects")
}

model EcuFile {
  id            String   @id @default(uuid())
  projectId     String   @map("project_id")
  filename      String
  fileSize      BigInt   @map("file_size")
  fileHash      String   @map("file_hash")
  fileFormat    String   @map("file_format")
  storagePath   String   @map("storage_path")
  encryptionKey String?  @map("encryption_key")
  metadata      Json     @default("{}")
  uploadedBy    String   @map("uploaded_by")
  createdAt     DateTime @default(now()) @map("created_at")
  
  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader User      @relation(fields: [uploadedBy], references: [id])
  maps     Map[]
  versions EcuFileVersion[]
  
  @@unique([fileHash])
  @@map("ecu_files")
}

model EcuFileVersion {
  id              String   @id @default(uuid())
  ecuFileId       String   @map("ecu_file_id")
  versionNumber   Int      @map("version_number")
  binaryData      Bytes?   @map("binary_data")
  binaryDiff      Bytes?   @map("binary_diff")
  parentVersionId String?  @map("parent_version_id")
  createdBy       String   @map("created_by")
  changelog       String?
  checksum        String?
  createdAt       DateTime @default(now()) @map("created_at")
  
  ecuFile       EcuFile          @relation(fields: [ecuFileId], references: [id], onDelete: Cascade)
  parentVersion EcuFileVersion?  @relation("VersionHistory", fields: [parentVersionId], references: [id])
  childVersions  EcuFileVersion[] @relation("VersionHistory")
  creator       User             @relation(fields: [createdBy], references: [id])
  
  @@unique([ecuFileId, versionNumber])
  @@map("ecu_file_versions")
}

model Map {
  id              String   @id @default(uuid())
  ecuFileId       String   @map("ecu_file_id")
  name            String
  type            String
  address         Int
  size            Int
  axisCount       Int      @map("axis_count")
  axisLabels      String[] @map("axis_labels")
  axisUnits       String[] @map("axis_units")
  valueUnit       String?  @map("value_unit")
  minValue        Float?   @map("min_value")
  maxValue        Float?   @map("max_value")
  rawData         Bytes?   @map("raw_data")
  metadata        Json     @default("{}")
  detectedByAi    Boolean  @default(false) @map("detected_by_ai")
  confidenceScore Float?   @map("confidence_score")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  
  ecuFile       EcuFile            @relation(fields: [ecuFileId], references: [id], onDelete: Cascade)
  values        MapValue[]
  modifications MapModification[]
  
  @@map("maps")
}

model MapValue {
  id            BigInt  @id @default(autoincrement())
  mapId         String  @map("map_id")
  axisIndex     Int[]   @map("axis_index")
  value         Float
  originalValue Float?  @map("original_value")
  modified      Boolean @default(false)
  
  map Map @relation(fields: [mapId], references: [id], onDelete: Cascade)
  
  @@map("map_values")
}

model MapModification {
  id               String   @id @default(uuid())
  mapId            String   @map("map_id")
  userId           String   @map("user_id")
  modificationType String   @map("modification_type")
  oldValues        Json     @map("old_values")
  newValues        Json     @map("new_values")
  reason           String?
  aiGenerated      Boolean  @default(false) @map("ai_generated")
  aiModelVersion   String?  @map("ai_model_version")
  createdAt        DateTime @default(now()) @map("created_at")
  
  map  Map  @relation(fields: [mapId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])
  
  @@map("map_modifications")
}

model Simulation {
  id           String    @id @default(uuid())
  projectId    String    @map("project_id")
  name         String
  type         String
  parameters   Json
  results      Json?
  telemetryData Json?    @map("telemetry_data")
  status       String    @default("pending")
  startedAt    DateTime? @map("started_at")
  completedAt  DateTime? @map("completed_at")
  errorMessage String?   @map("error_message")
  createdBy    String    @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator User    @relation(fields: [createdBy], references: [id])
  
  @@map("simulations")
}

model AiAnalysis {
  id              String   @id @default(uuid())
  projectId       String   @map("project_id")
  analysisType    String   @map("analysis_type")
  inputData       Json     @map("input_data")
  results         Json
  confidence      Float?
  modelVersion    String   @map("model_version")
  processingTimeMs Int?    @map("processing_time_ms")
  createdAt       DateTime @default(now()) @map("created_at")
  
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  @@map("ai_analyses")
}

model AuditLog {
  id           BigInt    @id @default(autoincrement())
  tenantId     String    @map("tenant_id")
  userId       String?   @map("user_id")
  action       String
  resourceType String    @map("resource_type")
  resourceId   String?   @map("resource_id")
  oldValues    Json?     @map("old_values")
  newValues    Json?     @map("new_values")
  ipAddress    String?   @map("ip_address")
  userAgent    String?   @map("user_agent")
  createdAt    DateTime  @default(now()) @map("created_at")
  
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}